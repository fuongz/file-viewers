{
	"name": "fileviewer",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --filter @apps/desktop app:dev",
		"landing:dev": "bun run --filter @apps/landing dev",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "bun run --filter '*' lint",
		"lint:fix": "bun run --filter '*' lint:fix"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"@biomejs/biome": "^2.6.8"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	},
	"overrides": {
		"dompurify": "3.4.18",
		"minimatch": "11.0.1",
		"postcss-selector-parser": "7.2.1"
	},
	"workspaces": [
		"apps/*"
	]
}
